<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.university</groupId>
    <artifactId>universitysystem</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <javafx.version>21</javafx.version>
        <!-- Launcher, never App. See project_details.md Section 8, CRITICAL BUILD RULE. -->
        <mainClass>com.university.Launcher</mainClass>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${javafx.version}</version>
        </dependency>


        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <version>13.4.0.jre11</version>
        </dependency>

        <!-- Connection pooling. Without it, every DAO call opened a brand new
             physical connection (TCP handshake + TLS + SQL Server login), which
             is what made the UI stall on ordinary screens. -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
        </dependency>

        <!-- HikariCP logs through SLF4J and pulls in slf4j-api 1.7.36, but an API
             with no binding behind it prints "Failed to load class
             org.slf4j.impl.StaticLoggerBinder" and then silently discards every
             message. That is not cosmetic: the pool reports connection failures
             through exactly this channel, so without a binding a database that
             refuses connections produces no explanation at all.

             slf4j-simple is pinned to the same 1.7.36 as the API on purpose. A
             2.x binding uses the ServiceLoader mechanism that 1.7.x does not
             look for, so the warning would come back and the logs would still
             go nowhere. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>1.7.36</version>
        </dependency>

        <!-- Password hashing. The users table stores BCrypt hashes, never
             plain text, so signing in needs this to verify them. -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

        <!-- The official PDF transcript (Phase 12). OpenPDF is the LGPL/MPL fork
             of iText 2.1.7, so every class lives under com.lowagie.text. iText 5
             and 7 are deliberately NOT used: iText 7 is AGPL and its API is
             entirely different. See phase-12/context/PDF_LAYOUT.md Section 1. -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>1.3.30</version>
        </dependency>

        <!-- Proves the Section 5 arithmetic, above all the worked example that must
             produce exactly 3.24. GradeCalculator is pure â€” no database, no JavaFX â€”
             which is precisely what makes it testable. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>

        <!-- Phase 4: builds/parses the Gemini API request and response bodies for the
             general-question fallback in GeneralAIService. Nothing else in the project
             talks JSON, so there was no existing library to reuse. -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20240303</version>
        </dependency>

    </dependencies>

    <build>

        <!-- The database migration scripts live next to the code that depends on
             them, under src/main/java/com/university/database/unidatabase, so a
             schema change and its Java travel in one commit. That is a source
             root, not a resource root, so Maven would not copy the .sql files
             anywhere; this makes it do so. MigrationRunner prefers the copy in
             the source tree when it can see it (no rebuild needed to pick up a
             new file) and falls back to this one otherwise.

             Declaring <resources> replaces the default, so src/main/resources
             has to be listed again here or every FXML, CSS and image would stop
             being packaged. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>com/university/database/unidatabase/migrations/*.sql</include>
                </includes>
            </resource>
        </resources>

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.university.Launcher</mainClass>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
