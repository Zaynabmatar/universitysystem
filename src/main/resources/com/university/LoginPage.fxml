<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.university.LoginController"
           styleClass="root-pane"
           stylesheets="@login.css"
           prefWidth="1000.0"
           prefHeight="650.0">

    <VBox styleClass="login-card" alignment="CENTER" spacing="16.0" maxWidth="420.0" maxHeight="640.0">
        <padding>
            <Insets top="40.0" right="45.0" bottom="35.0" left="45.0"/>
        </padding>

        <StackPane styleClass="logo-placeholder">
            <Circle radius="38.0" styleClass="logo-circle"/>
            <Label text="IUL" styleClass="logo-text"/>
        </StackPane>

        <VBox alignment="CENTER" spacing="2.0">
            <Label text="ISLAMIC UNIVERSITY OF LEBANON" styleClass="university-name"
                   wrapText="true" textAlignment="CENTER" maxWidth="320.0"/>
            <Label text="( I U L )" styleClass="university-subtitle"/>
        </VBox>

        <Label text="Welcome back, please login to your account" styleClass="welcome-text"
               wrapText="true" textAlignment="CENTER" maxWidth="300.0"/>

        <VBox spacing="14.0" styleClass="form-box">
            <TextField fx:id="usernameField" promptText="Username" styleClass="input-field"/>
            <PasswordField fx:id="passwordField" promptText="Password" styleClass="input-field"/>

            <HBox alignment="CENTER_RIGHT">
                <Hyperlink fx:id="forgotPasswordLink" text="Forgot Password?" styleClass="forgot-link"/>
            </HBox>

            <Button fx:id="loginButton" text="LOGIN" styleClass="login-button"
                    maxWidth="Infinity" onAction="#handleLogin"/>
        </VBox>

        <VBox alignment="CENTER" spacing="10.0" styleClass="follow-us-box">
            <Label text="Follow Us" styleClass="follow-us-label"/>
            <HBox alignment="CENTER" spacing="12.0">
                <Button text="f" styleClass="social-icon"/>
                <Button text="in" styleClass="social-icon"/>
                <Button text="IG" styleClass="social-icon"/>
                <Button text="X" styleClass="social-icon"/>
            </HBox>
        </VBox>

    </VBox>

</StackPane>
