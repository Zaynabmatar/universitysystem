<!-- Reusable "Student Info + Contact Us" footer, included at the end of every Student sidebar
     page (Classes, Academic Analytics, Payments, Registration, Transcript, Plan of Study). Not
     used on Online Service, Library, Moodle, or Logout. The controller fills in the signed-in
     student's own record independently of whichever page includes this fragment. -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.university.controller.StudentFooterController"
      styleClass="page-footer" spacing="18">
    <HBox spacing="80">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Student Info" styleClass="footer-heading"/>
            <Label fx:id="footerMajorLabel" styleClass="footer-line"/>
            <Label fx:id="footerMobileLabel" styleClass="footer-line"/>
            <Label fx:id="footerCampusLabel" styleClass="footer-line"/>
            <Label fx:id="footerIulEmailLabel" styleClass="footer-line"/>
            <Label fx:id="footerFirstRegLabel" styleClass="footer-line"/>
            <Label fx:id="footerLastRegLabel" styleClass="footer-line"/>
            <Label fx:id="footerProbationLabel" styleClass="footer-line"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Contact Us" styleClass="footer-heading"/>
            <Label text="Email: info@iul.edu.lb" styleClass="footer-line"/>
            <Label text="Phone: +961 5 807 700" styleClass="footer-line"/>
            <Label text="Fax: +961 5 807 701" styleClass="footer-line"/>
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="footer-social-row">
