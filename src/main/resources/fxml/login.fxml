<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.university.controller.LoginController"
           styleClass="login-root"
           prefWidth="1200" prefHeight="700">

    <VBox fx:id="card" styleClass="login-card" spacing="14" maxWidth="430" maxHeight="-Infinity">

        <Label text="University Registration System" styleClass="login-title" wrapText="true"/>
        <Label text="Sign in to continue" styleClass="login-subtitle"/>

        <VBox spacing="4">
            <Label text="Username"/>
            <TextField fx:id="usernameField" promptText="e.g. admin"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Password"/>
            <PasswordField fx:id="passwordField" promptText="Your password"/>
        </VBox>

        <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" managed="false" visible="false"/>

        <Button fx:id="loginButton" text="Sign in" defaultButton="true"
                maxWidth="Infinity" onAction="#handleLogin"/>

        <!-- Demo credentials hint — project_details.md Section 12 requires this on screen -->
        <VBox styleClass="hint-box" spacing="3">
            <Label text="Demo accounts" styleClass="section-title"/>
            <Label text="Admin        admin      /  Admin@123"       styleClass="muted-text"/>
            <Label text="Instructor   a.khoury   /  Instructor@123"  styleClass="muted-text"/>
            <Label text="Instructor   s.haddad   /  Instructor@123"  styleClass="muted-text"/>
            <Label text="Student      z.matar    /  Student@123"     styleClass="muted-text"/>
            <Label text="Student      o.saleh    /  Student@123"     styleClass="muted-text"/>
            <HBox spacing="8">
                <Hyperlink text="Fill admin"      onAction="#fillAdmin"/>
                <Hyperlink text="Fill instructor" onAction="#fillInstructor"/>
                <Hyperlink text="Fill student"    onAction="#fillStudent"/>
            </HBox>
        </VBox>

        <padding><Insets top="0" right="0" bottom="0" left="0"/></padding>
    </VBox>
</StackPane>
