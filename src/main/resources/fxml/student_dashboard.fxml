<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Root is an AnchorPane so the University AI Assistant panel can float as an OVERLAY on top of
     the dashboard instead of taking part in its layout. The ScrollPane below fills the whole
     AnchorPane and is completely unaffected by the assistant opening/closing: nothing in it ever
     resizes, moves, or reflows. The assistant itself is a second AnchorPane child, pinned to the
     top-right corner; an AnchorPane only sizes a child anchored on just two edges to that child's
     own preferred size, so it never stretches to cover (or intercept clicks over) the rest of the
     page — it only occupies the button, and then the panel, in the top-right corner. -->
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.university.controller.StudentDashboardController">
<children>

    <ScrollPane fitToWidth="true" styleClass="classes-scroll"
                hbarPolicy="NEVER" vbarPolicy="NEVER"
                AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
                AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
    <content>
        <VBox styleClass="content-page" spacing="12" minWidth="0">

            <Label text="My Registered Courses" styleClass="page-title"/>
            <Label fx:id="semesterBannerLabel" styleClass="muted-text"/>

            <TableView fx:id="coursesTable" minWidth="0">
                <columns>
                    <TableColumn fx:id="colCourseCode" text="Course Code" prefWidth="90"/>
                    <TableColumn fx:id="colCourseName" text="Course Title" prefWidth="260"/>
                    <TableColumn fx:id="colSection"    text="Section"     prefWidth="65"/>
                    <TableColumn fx:id="colCampus"     text="Campus"      prefWidth="90"/>
                    <TableColumn fx:id="colInstructor" text="Instructor"  prefWidth="130"/>
                    <TableColumn fx:id="colCrn"        text="CRN"         prefWidth="55"/>
                    <TableColumn fx:id="colSchedule"   text="Schedule"    prefWidth="220"/>
                    <TableColumn fx:id="colRoom"       text="Room"        prefWidth="70"/>
                    <TableColumn fx:id="colGrade"      text="Grade"       prefWidth="60"/>
                    <TableColumn fx:id="colStatus"     text="Status"      prefWidth="90"/>
                </columns>
            </TableView>

            <HBox spacing="24" alignment="CENTER_LEFT">
                <Label fx:id="totalCoursesLabel" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="totalCreditsLabel" styleClass="section-title"/>
            </HBox>

            <HBox spacing="20" alignment="TOP_LEFT">
                <VBox spacing="12" minWidth="0" HBox.hgrow="ALWAYS">
                    <Label text="Exams" styleClass="page-title"/>

                    <TableView fx:id="examsTable" minWidth="0">
                        <columns>
                            <TableColumn fx:id="examColCourseCode" text="Course Code"  prefWidth="90"/>
                            <TableColumn fx:id="examColCourseName" text="Course Title" prefWidth="260"/>
                            <TableColumn fx:id="examColRoom"       text="Room"         prefWidth="70"/>
                            <TableColumn fx:id="examColDate"       text="Date"         prefWidth="90"/>
                            <TableColumn fx:id="examColTime"       text="Start Time"   prefWidth="90"/>
                            <TableColumn fx:id="examColDuration"   text="Duration"     prefWidth="80"/>
                        </columns>
                    </TableView>

                    <HBox alignment="CENTER_RIGHT">
                        <Button text="View All Exams" onAction="#handleViewAllExams"/>
                    </HBox>
                </VBox>
                <VBox spacing="12" minWidth="0" HBox.hgrow="ALWAYS">
                    <Label text="Today's Schedule" styleClass="page-title"/>

                    <TableView fx:id="todaysScheduleTable" minWidth="0">
                        <columns>
                            <TableColumn fx:id="todayColTime"       text="Time"       prefWidth="120"/>
                            <TableColumn fx:id="todayColCourse"     text="Course"     prefWidth="220"/>
                            <TableColumn fx:id="todayColInstructor" text="Instructor" prefWidth="140"/>
                            <TableColumn fx:id="todayColRoom"       text="Room"       prefWidth="70"/>
                        </columns>
                    </TableView>

                    <HBox alignment="CENTER_RIGHT">
                        <Button text="View My Timetable" onAction="#handleViewMyTimetable"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </content>
    </ScrollPane>

    <!-- ===== University AI Assistant — floating top-right overlay. Collapsed by default (only
         this VBox's Button child is visible/managed), so it reserves no space at all. Clicking it
         opens the chat as a vertical panel directly beneath the button, layered on top of the
         dashboard above; the dashboard content in the ScrollPane never moves or resizes. ===== -->
    <VBox spacing="8" alignment="TOP_RIGHT" pickOnBounds="false"
          AnchorPane.topAnchor="16" AnchorPane.rightAnchor="16" AnchorPane.bottomAnchor="16">
        <Button fx:id="aiAssistantToggleButton" text="University AI Assistant"
                onAction="#handleToggleAiAssistant" styleClass="ai-assistant-toggle-btn"/>
        <VBox fx:id="aiAssistantExpandedBox" spacing="4" visible="false" managed="false"
              VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_RIGHT">
                <Button text="Collapse ▴" onAction="#handleToggleAiAssistant" styleClass="ai-assistant-collapse-btn"/>
            </HBox>
            <fx:include fx:id="aiAssistant" source="ai_assistant_panel.fxml" VBox.vgrow="ALWAYS"/>
        </VBox>
    </VBox>

</children>
</AnchorPane>
