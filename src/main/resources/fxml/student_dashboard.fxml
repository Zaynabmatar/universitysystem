<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.university.controller.StudentDashboardController"
      styleClass="content-page" spacing="12">

    <Label fx:id="contextLabel" styleClass="muted-text"/>

    <!-- ===== four KPI cards ===== -->
    <HBox spacing="12">
        <VBox styleClass="kpi-card" spacing="2">
            <Label fx:id="gpaLabel" text="0.00" styleClass="kpi-value"/>
            <Label text="Cumulative GPA" styleClass="kpi-label"/>
        </VBox>
        <VBox styleClass="kpi-card" spacing="2">
            <Label fx:id="standingLabel" text="—" styleClass="kpi-value"/>
            <Label text="Academic Standing" styleClass="kpi-label"/>
        </VBox>
        <VBox styleClass="kpi-card" spacing="2">
            <Label fx:id="creditsLabel" text="0" styleClass="kpi-value"/>
            <Label text="Credits Earned" styleClass="kpi-label"/>
        </VBox>
        <VBox styleClass="kpi-card" spacing="2">
            <Label fx:id="unreadLabel" text="0" styleClass="kpi-value"/>
            <Label text="Unread Notifications" styleClass="kpi-label"/>
        </VBox>
    </HBox>

    <!-- ===== progress strip ===== -->
    <VBox spacing="5" styleClass="panel">
        <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Degree progress" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="progressPercentLabel" text="—"/>
            <Hyperlink text="View details" onAction="#handleOpenProgress"/>
        </HBox>
        <ProgressBar fx:id="miniProgressBar" progress="0.0" prefHeight="14"
                     maxWidth="Infinity" styleClass="degree-progress"/>
    </VBox>

    <!-- ===== next classes + notifications side by side ===== -->
    <HBox spacing="12" VBox.vgrow="ALWAYS">
        <VBox spacing="6" styleClass="panel" HBox.hgrow="ALWAYS" prefWidth="420">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Label text="Your next classes" styleClass="section-title"/>
            <ListView fx:id="nextClassesList" VBox.vgrow="ALWAYS"/>
        </VBox>
        <VBox spacing="6" styleClass="panel" HBox.hgrow="ALWAYS" prefWidth="420">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Notifications" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink text="See all" onAction="#handleOpenNotifications"/>
            </HBox>
            <ListView fx:id="notificationsList" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>

    <!-- ===== quick actions ===== -->
    <HBox spacing="10">
        <Button text="Register for courses" onAction="#handleOpenRegistration" defaultButton="true"/>
        <Button text="Recommended for you"  onAction="#handleOpenRecommendations"/>
        <Button text="My timetable"         onAction="#handleOpenTimetable"/>
        <Button text="My grades"            onAction="#handleOpenGrades"/>
        <Button text="My transcript"        onAction="#handleOpenTranscript"/>
    </HBox>
</VBox>
