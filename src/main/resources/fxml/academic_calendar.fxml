<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.university.controller.StudentAcademicCalendarController"
            fitToWidth="true" styleClass="page-scroll">
    <content>
    <VBox styleClass="content-page" spacing="18">

        <HBox spacing="10" alignment="CENTER_LEFT"><Label text="Academic Calendar" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Semester:"/>
            <ComboBox fx:id="semesterCombo" prefWidth="200"/>
        </HBox>

        <Label text="A view-only academic calendar built from your real semester dates, registration window, exams, payment due date and any events the Admin has added."
               styleClass="muted-text" wrapText="true"/>

        <HBox spacing="18" alignment="TOP_LEFT">
            <VBox fx:id="calendarBox" spacing="14" HBox.hgrow="ALWAYS"/>
            <VBox fx:id="legendBox" styleClass="calendar-legend" spacing="8"/>
        </HBox>

        <VBox styleClass="calendar-notes-card" spacing="8">
            <Label text="Academic Notes" styleClass="section-title"/>
            <VBox fx:id="notesBox" spacing="6">
                <padding><Insets top="2" right="0" bottom="0" left="0"/></padding>
            </VBox>
        </VBox>

    </VBox>
    </content>
</ScrollPane>
