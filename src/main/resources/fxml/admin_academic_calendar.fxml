<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.university.controller.AdminAcademicCalendarController"
            fitToWidth="true" styleClass="page-scroll">
    <content>
    <VBox styleClass="content-page" spacing="18">

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Academic Calendar" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Semester:"/>
            <ComboBox fx:id="semesterCombo" prefWidth="200"/>
        </HBox>
        <Label text="Semester dates, registration, drop/withdraw deadlines, exams and payment due dates come from their own screens automatically. Click an empty date to add a custom event, or click an existing one to edit it."
               styleClass="muted-text" wrapText="true"/>

        <HBox spacing="18" alignment="TOP_LEFT">
            <VBox fx:id="calendarBox" spacing="14" HBox.hgrow="ALWAYS"/>
            <VBox fx:id="legendBox" styleClass="calendar-legend" spacing="8"/>
        </HBox>

        <VBox styleClass="calendar-notes-card" spacing="8">
            <Label text="Academic Notes" styleClass="section-title"/>
            <VBox fx:id="notesBox" spacing="6">
                <padding><Insets top="2" right="0" bottom="0" left="0"/></padding>
            </VBox>
        </VBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Custom Events" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel" styleClass="muted-text"/>
        </HBox>

        <TableView fx:id="eventTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colTitle"  text="Title"      prefWidth="220"/>
                <TableColumn fx:id="colType"   text="Type"       prefWidth="150"/>
                <TableColumn fx:id="colDates"  text="Dates"      prefWidth="220"/>
                <TableColumn fx:id="colStatus" text="Status"     prefWidth="110"/>
            </columns>
        </TableView>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="4" right="0" bottom="0" left="0"/></padding>
            <Button text="Add Event" onAction="#handleAdd"/>
            <Button fx:id="editButton" text="Edit" onAction="#handleEdit"/>
            <Button fx:id="deactivateButton" text="Deactivate" onAction="#handleDeactivate"/>
            <Button fx:id="reactivateButton" text="Reactivate" onAction="#handleReactivate"/>
            <Button fx:id="deleteButton" text="Delete" onAction="#handleDelete"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#handleRefresh"/>
        </HBox>

    </VBox>
    </content>
</ScrollPane>
