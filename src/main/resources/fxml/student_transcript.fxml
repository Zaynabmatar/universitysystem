<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.university.controller.StudentTranscriptController"
      styleClass="content-page" spacing="12">

    <!-- ===== header ===== -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label text="Academic Transcript" styleClass="page-title"/>
            <Label fx:id="subtitleLabel" styleClass="muted-text"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="refreshButton"   text="Refresh"       onAction="#handleRefresh"/>
        <Button fx:id="exportPdfButton" text="Export as PDF" onAction="#handleExportPdf"
                defaultButton="true"/>
    </HBox>

    <!-- ===== KPI strip ===== -->
    <HBox spacing="12">
        <VBox styleClass="kpi-card" spacing="2">
            <Label fx:id="cumulativeGpaLabel" text="0.00" styleClass="kpi-value"/>
            <Label text="Cumulative GPA" styleClass="kpi-label"/>
        </VBox>
        <VBox styleClass="kpi-card" spacing="2">
            <Label fx:id="creditsLabel" text="0" styleClass="kpi-value"/>
            <Label text="Credits Earned" styleClass="kpi-label"/>
        </VBox>
        <VBox styleClass="kpi-card" spacing="2">
            <Label fx:id="standingLabel" text="—" styleClass="kpi-value"/>
            <Label text="Academic Standing" styleClass="kpi-label"/>
        </VBox>
        <VBox styleClass="kpi-card" spacing="2">
            <Label fx:id="termCountLabel" text="0" styleClass="kpi-value"/>
            <Label text="Semesters Studied" styleClass="kpi-label"/>
        </VBox>
    </HBox>

    <!-- ===== one card per semester, built in code ===== -->
    <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                styleClass="transcript-scroll">
        <content>
            <VBox fx:id="termContainer" spacing="16">
                <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
            </VBox>
        </content>
    </ScrollPane>

    <Label fx:id="footerLabel" styleClass="muted-label" wrapText="true"
           text="Courses marked “Repeated” are superseded attempts and do not count towards the GPA. Grades of W and I carry no grade points. Dropped courses never appear on a transcript."/>
</VBox>
