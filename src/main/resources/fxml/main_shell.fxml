<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.university.controller.MainShellController"
            prefWidth="1200" prefHeight="700">

    <top>
        <HBox styleClass="top-bar" spacing="12" alignment="CENTER_LEFT">
            <Label text="University Registration System" styleClass="app-name"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="semesterLabel" text=""/>
            <StackPane styleClass="bell-stack">
                <Button fx:id="notificationsButton" text="🔔 Notifications" onAction="#handleNotifications"/>
                <Label fx:id="unreadBadge" text="0" styleClass="bell-badge"
                       StackPane.alignment="TOP_RIGHT" managed="false" visible="false"/>
            </StackPane>
            <Label fx:id="userLabel" text=""/>
            <Button fx:id="logoutButton" text="Log out" onAction="#handleLogout"/>
        </HBox>
    </top>

    <left>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="sidebar-scroll">
            <VBox fx:id="sidebar" styleClass="sidebar" spacing="2"/>
        </ScrollPane>
    </left>

    <center>
        <StackPane fx:id="contentArea"/>
    </center>
</BorderPane>
