<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Root is an AnchorPane so the University AI Assistant panel can float as an OVERLAY on top of
     the dashboard instead of taking part in its layout — the same pattern used on the Student and
     Instructor dashboards. The original content VBox below is pinned to all four edges (0,0,0,0)
     and is completely unaffected by the assistant opening/closing: nothing in it ever resizes,
     moves, or reflows. The assistant itself is a second AnchorPane child, pinned to the top-right
     corner; an AnchorPane only sizes a child anchored on just two edges to that child's own
     preferred size, so it never stretches to cover (or intercept clicks over) the rest of the
     page — it only occupies the button, and then the panel, in the top-right corner. -->
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.university.controller.AdminDashboardController">
<children>

    <VBox styleClass="content-page" spacing="8" style="-fx-padding: 14;"
          AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">

    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 210 0 0;">
        <VBox spacing="2">
            <Label text="Dashboard" styleClass="page-title"/>
            <Label fx:id="semesterLabel" styleClass="muted-text"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="reportsButton" text="Full Reports" onAction="#handleOpenReports"/>
        <Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh"/>
    </HBox>

    <VBox spacing="8" VBox.vgrow="ALWAYS">
        <padding><Insets top="4" right="2" bottom="4" left="2"/></padding>

        <!-- Section 10, row 1 — the four KPI cards -->
        <FlowPane fx:id="kpiRow" hgap="10" vgap="8">
            <VBox styleClass="kpi-card" spacing="2" style="-fx-padding: 8; -fx-min-width: 150;">
                <Label fx:id="kpiStudents" text="—" styleClass="kpi-value" style="-fx-font-size: 20px;"/>
                <Label text="Active students" styleClass="kpi-label"/>
            </VBox>
            <VBox styleClass="kpi-card" spacing="2" style="-fx-padding: 8; -fx-min-width: 150;">
                <Label fx:id="kpiInstructors" text="—" styleClass="kpi-value" style="-fx-font-size: 20px;"/>
                <Label text="Instructors" styleClass="kpi-label"/>
            </VBox>
            <VBox styleClass="kpi-card" spacing="2" style="-fx-padding: 8; -fx-min-width: 150;">
                <Label fx:id="kpiCourses" text="—" styleClass="kpi-value" style="-fx-font-size: 20px;"/>
                <Label text="Courses in the catalogue" styleClass="kpi-label"/>
            </VBox>
            <VBox styleClass="kpi-card" spacing="2" style="-fx-padding: 8; -fx-min-width: 150;">
                <Label fx:id="kpiSections" text="—" styleClass="kpi-value" style="-fx-font-size: 20px;"/>
                <Label text="Active sections this semester" styleClass="kpi-label"/>
            </VBox>
            <VBox styleClass="kpi-card" spacing="2" style="-fx-padding: 8; -fx-min-width: 150;">
                <Label fx:id="kpiAvgGpa" text="—" styleClass="kpi-value" style="-fx-font-size: 20px;"/>
                <Label text="University average GPA" styleClass="kpi-label"/>
            </VBox>
        </FlowPane>

        <Label fx:id="secondaryLabel" text="" styleClass="muted-text" style="-fx-font-size: 11px;"/>

        <!-- charts -->
        <HBox spacing="10" VBox.vgrow="ALWAYS">
            <StackPane fx:id="deptHolder" HBox.hgrow="ALWAYS" minHeight="120" style="-fx-padding: 6;" styleClass="chart-card">
                <BarChart fx:id="deptChart" title="Enrollment per department"
                          legendVisible="false" animated="false">
                    <xAxis><CategoryAxis fx:id="deptX" label="Department"/></xAxis>
                    <yAxis><NumberAxis fx:id="deptY" label="Students enrolled"/></yAxis>
                </BarChart>
                <Label fx:id="deptEmpty" styleClass="chart-empty" visible="false" managed="false"
                       text="No enrollments in the current semester yet."/>
            </StackPane>

            <StackPane fx:id="gradeHolder" HBox.hgrow="ALWAYS" minHeight="200" minWidth="260" style="-fx-padding: 6;" styleClass="chart-card">
                <PieChart fx:id="gradeChart" title="Grade distribution" legendSide="RIGHT" animated="false"
                          styleClass="grade-pie-chart"/>
                <Label fx:id="gradeEmpty" styleClass="chart-empty" visible="false" managed="false"
                       text="No grades have been submitted yet, so there is nothing to chart."/>
            </StackPane>
        </HBox>

        <StackPane fx:id="trendHolder" minHeight="120" style="-fx-padding: 6;" styleClass="chart-card" VBox.vgrow="ALWAYS">
            <LineChart fx:id="trendChart" title="Enrollment trend across semesters"
                       legendVisible="false" animated="false">
                <xAxis><CategoryAxis fx:id="trendX" label="Semester"/></xAxis>
                <yAxis><NumberAxis fx:id="trendY" label="Enrollments"/></yAxis>
            </LineChart>
            <Label fx:id="trendEmpty" styleClass="chart-empty" visible="false" managed="false"
                   text="No enrollment history yet."/>
        </StackPane>
    </VBox>
    </VBox>

    <!-- ===== University AI Assistant — floating top-right overlay. Collapsed by default (only
         this VBox's Button child is visible/managed), so it reserves no space at all. Clicking it
         opens the chat as a vertical panel directly beneath the button, layered on top of the
         dashboard above; the dashboard content above never moves or resizes. ===== -->
    <VBox spacing="8" alignment="TOP_RIGHT" pickOnBounds="false"
          AnchorPane.topAnchor="16" AnchorPane.rightAnchor="16" AnchorPane.bottomAnchor="16">
        <Button fx:id="aiAssistantToggleButton" text="University AI Assistant"
                onAction="#handleToggleAiAssistant" styleClass="ai-assistant-toggle-btn"/>
        <VBox fx:id="aiAssistantExpandedBox" spacing="4" visible="false" managed="false"
              VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_RIGHT">
                <Button text="Close" onAction="#handleToggleAiAssistant" styleClass="ai-assistant-collapse-btn"/>
            </HBox>
            <fx:include fx:id="aiAssistant" source="ai_assistant_panel.fxml" VBox.vgrow="ALWAYS"/>
        </VBox>
    </VBox>

</children>
</AnchorPane>
