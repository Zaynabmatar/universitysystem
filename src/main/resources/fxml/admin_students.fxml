<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.university.controller.AdminStudentsController"
            fitToWidth="true" styleClass="page-scroll">
<content>
<VBox styleClass="content-page" spacing="12">

    <Label text="Manage Students" styleClass="page-title"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search by Student ID, name or email" prefWidth="280"/>
        <ComboBox fx:id="programFilter" promptText="All programs" prefWidth="220"/>
        <ComboBox fx:id="statusFilter"  promptText="All statuses" prefWidth="150"/>
        <Button text="Clear filters" onAction="#handleClearFilters"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="muted-text"/>
    </HBox>

    <TableView fx:id="studentTable" prefHeight="400" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colStudentId" text="Student ID"   prefWidth="110"/>
            <TableColumn fx:id="colName"      text="Name"         prefWidth="180"/>
            <TableColumn fx:id="colEmail"     text="Email"        prefWidth="210"/>
            <TableColumn fx:id="colPhone"     text="Phone"        prefWidth="120"/>
            <TableColumn fx:id="colProgram"   text="Program"      prefWidth="110"/>
            <TableColumn fx:id="colStatus"    text="Status"       prefWidth="100"/>
            <TableColumn fx:id="colStanding"  text="Standing"     prefWidth="110"/>
            <TableColumn fx:id="colGpa"       text="GPA"          prefWidth="70"/>
            <TableColumn fx:id="colCredits"   text="Credits"      prefWidth="70"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="addButton"        text="Add Student"     onAction="#handleAdd"/>
        <Button fx:id="editButton"       text="Edit"            onAction="#handleEdit"/>
        <Button fx:id="deactivateButton" text="Deactivate"      onAction="#handleDeactivate"/>
        <Button fx:id="reactivateButton" text="Reactivate"      onAction="#handleReactivate"/>
        <Button fx:id="resetPwdButton"   text="Reset Password"  onAction="#handleResetPassword"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" onAction="#handleRefresh"/>
    </HBox>

    <!-- ================= Send Notification to Students ================= -->
    <VBox styleClass="panel" spacing="10">
        <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

        <Label text="Send Notification to Students" styleClass="section-title"/>

        <HBox spacing="20" alignment="CENTER_LEFT">
            <RadioButton fx:id="notifyAllRadio"      text="All Students" selected="true"/>
            <RadioButton fx:id="notifyDeptRadio"     text="By Department / Program"/>
            <RadioButton fx:id="notifySpecificRadio" text="Specific Student"/>
        </HBox>

        <HBox fx:id="notifyDeptProgramBox" spacing="10" alignment="CENTER_LEFT" managed="false" visible="false">
            <Label text="Department:"/>
            <ComboBox fx:id="notifyDepartmentBox" prefWidth="220" promptText="Select department"/>
            <Label text="Program (optional):"/>
            <ComboBox fx:id="notifyProgramBox" prefWidth="240" promptText="All programs" disable="true"/>
        </HBox>

        <HBox fx:id="notifySpecificBox" spacing="10" alignment="CENTER_LEFT" managed="false" visible="false">
            <Label text="Search:"/>
            <TextField fx:id="notifySearchField" promptText="Search by Student ID or name" prefWidth="260"/>
            <ComboBox fx:id="notifyResultsBox" prefWidth="280" promptText="Select a student"/>
        </HBox>

        <Label fx:id="notifyRecipientCountLabel" styleClass="muted-text"/>

        <Label text="Subject *"/>
        <TextField fx:id="notifySubjectField" promptText="Subject" maxWidth="Infinity"/>

        <Label text="Message *"/>
        <TextArea fx:id="notifyMessageField" promptText="Message" prefRowCount="4" wrapText="true"/>

        <HBox alignment="CENTER_RIGHT">
            <Button fx:id="sendNotificationButton" text="Send Notification" onAction="#handleSendNotification"/>
        </HBox>
    </VBox>

</VBox>
</content>
</ScrollPane>
