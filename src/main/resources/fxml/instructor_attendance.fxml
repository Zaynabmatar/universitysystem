<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.university.controller.InstructorAttendanceController"
      styleClass="content-page" spacing="10">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="titleLabel" text="Attendance" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" onAction="#handleRefresh"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Section:"/>
        <ComboBox fx:id="sectionCombo" prefWidth="360"/>
        <Label fx:id="sectionLabel" styleClass="muted-text"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Class Calendar:" styleClass="section-title"/>
        <Label fx:id="dateHintLabel" styleClass="muted-label"/>
    </HBox>

    <ScrollPane fx:id="calendarScroll" fitToWidth="true" prefHeight="260"
                styleClass="panel, calendar-scroll">
        <VBox fx:id="monthsBox" spacing="14" styleClass="calendar-months-box">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
        </VBox>
    </ScrollPane>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Search:"/>
        <TextField fx:id="searchField" promptText="Search by student name or ID" prefWidth="260"/>
    </HBox>

    <TableView fx:id="attendanceTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colStudentId"   text="Student ID"          prefWidth="110"/>
            <TableColumn fx:id="colStudentName" text="Student Name"        prefWidth="220"/>
            <TableColumn fx:id="colSection"     text="Section"             prefWidth="150"/>
            <TableColumn fx:id="colStatus"      text="Attendance Status"   prefWidth="160"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <padding><Insets top="4" right="0" bottom="0" left="0"/></padding>
        <Label fx:id="statsLabel" styleClass="muted-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="saveButton" text="Save Attendance" onAction="#handleSave" defaultButton="true"/>
    </HBox>
</VBox>
