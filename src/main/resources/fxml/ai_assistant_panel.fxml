<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- ===== University AI Assistant — shared chat panel, included by student/instructor/admin
     screens via fx:include. See AIAssistantPanelController; each host calls configure() with a
     role-appropriate greeting and quick questions right after this panel loads. ===== -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.university.controller.AIAssistantPanelController"
      spacing="10" styleClass="ai-assistant-panel"
      minWidth="300" prefWidth="340" maxWidth="400">
    <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="University AI Assistant" styleClass="ai-assistant-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="New Chat" onAction="#handleNewChat" styleClass="ai-new-chat-btn"/>
    </HBox>

    <FlowPane fx:id="quickQuestionsPane" hgap="6" vgap="6" styleClass="quick-questions-pane"/>

    <ScrollPane fx:id="chatScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="chat-scroll">
        <content>
            <VBox fx:id="chatMessagesBox" spacing="10" styleClass="chat-messages-box">
                <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
            </VBox>
        </content>
    </ScrollPane>

    <Label fx:id="typingIndicatorLabel" text="AI is typing..." styleClass="ai-typing-indicator"
           visible="false" managed="false"/>

    <!-- Selected attachment preview — shown only while a Photo/PDF/Document is attached and not
         yet sent; #handleRemoveAttachment clears it without sending anything. -->
    <HBox fx:id="attachmentPreviewBox" spacing="6" alignment="CENTER_LEFT"
          styleClass="ai-attachment-chip" visible="false" managed="false">
        <Label fx:id="attachmentNameLabel" styleClass="ai-attachment-chip-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="attachmentRemoveButton" text="✕" onAction="#handleRemoveAttachment"
                styleClass="ai-attachment-remove-btn"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER">
        <Button fx:id="attachButton" onAction="#handleAttachClick" styleClass="ai-attach-btn">
            <graphic>
                <!-- Standard "plus" glyph, matching the mic icon's stroke weight/scale. -->
                <SVGPath styleClass="ai-attach-icon" scaleX="0.68" scaleY="0.68"
                         content="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z"/>
            </graphic>
        </Button>
        <TextField fx:id="chatInputField" promptText="Ask the University AI Assistant..."
                   styleClass="ai-chat-input" HBox.hgrow="ALWAYS" onAction="#handleSendMessage"/>
        <Button fx:id="micButton" onAction="#handleVoiceInput" styleClass="ai-mic-btn">
            <graphic>
                <!-- Standard solid microphone glyph (capsule head + cradle + stand), the same
                     shape used by most messaging apps' voice-input buttons. -->
                <SVGPath styleClass="ai-mic-icon" scaleX="0.68" scaleY="0.68"
                         content="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5-3c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/>
            </graphic>
        </Button>
        <Button fx:id="sendButton" text="Send" onAction="#handleSendMessage" styleClass="ai-send-btn"/>
    </HBox>
</VBox>
