<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.university.controller.AdminPrerequisitesController"
      styleClass="content-page" spacing="12">

    <Label text="Prerequisites &amp; Degree Plans" styleClass="page-title"/>

    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
        <tabs>
            <Tab text="Course Prerequisites">
                <VBox spacing="10" styleClass="content-page">
                    <Label text="A prerequisite is a course that must be passed before another course can be taken."
                           styleClass="muted-text"/>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Show prerequisites of:"/>
                        <ComboBox fx:id="prereqCourseFilter" prefWidth="300" promptText="All courses"/>
                        <Button text="Clear" onAction="#handleClearPrereqFilter"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="prereqCountLabel" styleClass="muted-text"/>
                    </HBox>

                    <TableView fx:id="prereqTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colPCourse"      text="Course"             prefWidth="100"/>
                            <TableColumn fx:id="colPCourseTitle" text="Course Title"       prefWidth="200"/>
                            <TableColumn fx:id="colPRequires"    text="Requires"           prefWidth="100"/>
                            <TableColumn fx:id="colPReqTitle"    text="Prerequisite Title" prefWidth="200"/>
                            <TableColumn fx:id="colPMinGrade"    text="Minimum Grade"      prefWidth="120"/>
                        </columns>
                    </TableView>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Add Prerequisite"          onAction="#handleAddPrereq"/>
                        <Button fx:id="editPrereqButton"   text="Edit Minimum Grade" onAction="#handleEditPrereq"/>
                        <Button fx:id="removePrereqButton" text="Remove"             onAction="#handleRemovePrereq"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Refresh" onAction="#handleRefreshPrereq"/>
                    </HBox>
                </VBox>
            </Tab>

            <Tab text="Degree Plan Requirements">
                <VBox spacing="10" styleClass="content-page">
                    <Label text="Which courses a degree plan requires: mandatory or elective, and the semester it is normally taken in."
                           styleClass="muted-text"/>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Program:"/>
                        <ComboBox fx:id="reqProgramFilter" prefWidth="300"/>
                        <CheckBox fx:id="mandatoryOnlyCheck" text="Mandatory only"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="reqSummaryLabel" styleClass="muted-text"/>
                    </HBox>

                    <TableView fx:id="reqTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colRCourse"   text="Course"               prefWidth="100"/>
                            <TableColumn fx:id="colRTitle"    text="Title"                prefWidth="240"/>
                            <TableColumn fx:id="colRCredits"  text="Credits"              prefWidth="70"/>
                            <TableColumn fx:id="colRKind"     text="Type"                 prefWidth="100"/>
                            <TableColumn fx:id="colRSemester" text="Recommended Semester" prefWidth="150"/>
                        </columns>
                    </TableView>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Add Course to Plan"      onAction="#handleAddRequirement"/>
                        <Button fx:id="editReqButton"   text="Edit"             onAction="#handleEditRequirement"/>
                        <Button fx:id="removeReqButton" text="Remove from Plan" onAction="#handleRemoveRequirement"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Refresh" onAction="#handleRefreshRequirements"/>
                    </HBox>
                </VBox>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
