<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.university.controller.StudentRegistrationController"
            fitToWidth="true" styleClass="page-scroll">
    <content>
    <VBox styleClass="content-page" spacing="10">

        <Label text="Register for Courses" styleClass="page-title"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label fx:id="semesterLabel" styleClass="current-semester-banner"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="creditsBadge" styleClass="badge badge-neutral"/>
        </HBox>

        <Label text="Available sections" styleClass="section-title"/>
        <TableView fx:id="availableTable">
            <columns>
                <TableColumn fx:id="colCourse"     text="Course"     prefWidth="80"/>
                <TableColumn fx:id="colTitle"      text="Title"      prefWidth="200"/>
                <TableColumn fx:id="colCredits"    text="Credits"    prefWidth="65"/>
                <TableColumn fx:id="colInstructor" text="Instructor" prefWidth="150"/>
                <TableColumn fx:id="colSchedule"   text="Weekly Schedule" prefWidth="230"/>
                <TableColumn fx:id="colSeats"      text="Seats"      prefWidth="75"/>
                <TableColumn fx:id="colStatus"     text="Status"     prefWidth="130"/>
            </columns>
        </TableView>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="2" right="0" bottom="2" left="0"/></padding>
            <Button fx:id="registerButton" text="Register" onAction="#handleRegister"/>
            <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" maxWidth="600"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#handleRefresh"/>
        </HBox>

        <Label text="My current registrations" styleClass="section-title"/>
        <TableView fx:id="myTable">
            <columns>
                <TableColumn fx:id="myColCourse"   text="Course"  prefWidth="80"/>
                <TableColumn fx:id="myColSection"  text="Section" prefWidth="70"/>
                <TableColumn fx:id="myColTitle"    text="Title"   prefWidth="220"/>
                <TableColumn fx:id="myColCredits"  text="Credits" prefWidth="65"/>
                <TableColumn fx:id="myColSchedule" text="Weekly Schedule" prefWidth="260"/>
                <TableColumn fx:id="myColRoom"     text="Room"    prefWidth="90"/>
            </columns>
        </TableView>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="dropButton" text="Drop / Withdraw" onAction="#handleDrop"/>
        </HBox>

        <fx:include source="student_footer.fxml"/>
    </VBox>
    </content>
</ScrollPane>
