<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.university.controller.InstructorGradesController"
      styleClass="content-page" spacing="10">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="titleLabel" text="Enter Grades" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" onAction="#handleRefresh"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Section:"/>
        <ComboBox fx:id="sectionCombo" prefWidth="360"/>
        <Label fx:id="sectionLabel" styleClass="muted-text"/>
    </HBox>

    <Label styleClass="muted-label" wrapText="true"
           text="You can publish Midterm alone. Final must be published together with Lab or Coursework, depending on the course."/>

    <HBox spacing="14" alignment="CENTER_LEFT">
        <Label fx:id="windowLabel" styleClass="muted-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lockBanner" styleClass="lock-banner" wrapText="true"
               visible="false" managed="false"/>
    </HBox>

    <Label fx:id="weightingLabel" styleClass="muted-label"/>

    <TableView fx:id="gradeTable" editable="true" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colStudentId"     text="Student ID"       prefWidth="110" editable="false"/>
            <TableColumn fx:id="colStudentName"   text="Student"          prefWidth="200" editable="false"/>
            <TableColumn fx:id="colCoursework"    text="Coursework"       prefWidth="110"/>
            <TableColumn fx:id="colMidterm"       text="Midterm"          prefWidth="110"/>
            <TableColumn fx:id="colLab"           text="Lab"              prefWidth="90"/>
            <TableColumn fx:id="colFinal"         text="Final"            prefWidth="100"/>
            <TableColumn fx:id="colTotal"         text="Total"            prefWidth="80"  editable="false"/>
            <TableColumn fx:id="colLetter"        text="Letter"           prefWidth="70"  editable="false"/>
            <TableColumn fx:id="colPoints"        text="Points"           prefWidth="70"  editable="false"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <padding><Insets top="4" right="0" bottom="0" left="0"/></padding>
        <Label fx:id="statsLabel" styleClass="muted-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="exportButton"    text="Export CSV"      onAction="#handleExportCsv"/>
        <Button fx:id="saveDraftButton" text="Save Draft"      onAction="#handleSaveDraft"/>
        <Button fx:id="publishButton"   text="Publish"         onAction="#handlePublish"/>
        <Button fx:id="unlockButton"    text="Unlock Grades"   onAction="#handleUnlock"/>
        <Button fx:id="submitButton"    text="Submit and Lock" onAction="#handleSubmit"/>
    </HBox>
</VBox>
